<!--
  CI 전용 프로젝트. Unity 없이 레드닷 트리 코어를 컴파일한다.

  목적이 두 가지다.
  1. Unity 라이선스 없이도 매 푸시마다 컴파일 회귀를 잡는다.
  2. "트리 로직은 순수 C#, Unity 비의존"이라는 README의 주장을 빌드로 강제한다.
     RedDotNode / RedDotHierarchy 에 UnityEngine 참조가 들어오면 이 빌드가 깨진다.

  Manager 와 Icon 계열은 MonoBehaviour / TextMeshPro 에 의존하는 Unity 계층이라
  의도적으로 제외한다. 이 제외 목록이 길어진다면 코어와 Unity 계층을 폴더와
  asmdef 로 실제 분리할 시점이라는 신호다.

  Unity가 실제로 쓰는 조합에 맞춰 netstandard2.1 / C# 9 로 고정한다.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>RedDotSystem.Core</AssemblyName>
    <RootNamespace>RedDotSystem</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/**/*.cs"
             Exclude="../../Runtime/RedDotManager.cs;../../Runtime/RedDotIcon.cs;../../Runtime/RedDotCountIcon.cs" />
  </ItemGroup>

</Project>
